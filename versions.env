# Pinned sources. A build refuses any download that does not match its SHA-256.

FFMPEG_VERSION=9.0.1
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.1.tar.xz
# Checked against FFmpeg's release signature, key FCF986EA15E6E293A5644F10B4322F04D67658D8.
FFMPEG_SHA256=cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635

LAME_VERSION=3.100
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
# The same checksum Debian and Homebrew pin.
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

OPUS_VERSION=1.6.1
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz
# Matches xiph's SHA256SUMS.txt and Homebrew's pin.
OPUS_SHA256=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1

# Raised when the build itself changes without a new source, so every release
# name stays unique.
BUILD_REVISION=1
