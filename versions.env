# Pinned sources. A build refuses any download that does not match its SHA-256.
# Each *_FILE is the name the tarball is kept and published under.

FFMPEG_VERSION=9.0.1
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.1.tar.xz
FFMPEG_FILE=ffmpeg-9.0.1.tar.xz
# Checked against FFmpeg's release signature, key FCF986EA15E6E293A5644F10B4322F04D67658D8.
FFMPEG_SHA256=cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635

LAME_VERSION=3.100
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
LAME_FILE=lame-3.100.tar.gz
# The same checksum Debian and Homebrew pin.
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

OPUS_VERSION=1.6.1
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz
OPUS_FILE=opus-1.6.1.tar.gz
# Matches xiph's SHA256SUMS.txt and Homebrew's pin.
OPUS_SHA256=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1

DAV1D_VERSION=1.5.4
DAV1D_URL=https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz
DAV1D_FILE=dav1d-1.5.4.tar.xz
# Matches the checksum VideoLAN publishes beside the tarball, and the tarball's
# signature by the VideoLAN release key 65F7C6B4206BD057A7EB73787180713BE58D1ADC.
DAV1D_SHA256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5

VPX_VERSION=1.17.0
VPX_URL=https://github.com/webmproject/libvpx/archive/refs/tags/v1.17.0.tar.gz
VPX_FILE=libvpx-1.17.0.tar.gz
# The same checksum Homebrew pins.
VPX_SHA256=1020f184046187baa2985dbde38e0691f49c44088bca7a1842b0236c6081dc0a

# Windows only: macOS has zlib itself.
ZLIB_VERSION=1.3.2
ZLIB_URL=https://zlib.net/zlib-1.3.2.tar.gz
ZLIB_FILE=zlib-1.3.2.tar.gz
# Matches the release on GitHub and Homebrew's pin, and carries Mark Adler's
# signature, key 5ED46A6721D365587791E2AA783FCD8E58BCAFBA.
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16

# Raised when the build itself changes without a new source, so every release
# name stays unique.
BUILD_REVISION=1
